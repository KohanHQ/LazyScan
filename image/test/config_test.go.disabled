package config

import (
	"testing"
	"time"
)

func stubEnv(values map[string]string) func(string) string {
	return func(key string) string { return values[key] }
}

// requiredEnv is the minimal valid environment: pipeline connections and the
// storage profile have no defaults.
func requiredEnv() map[string]string {
	return map[string]string{
		"DATABASE_URL":              "postgresql://lazyscan:lazyscan@localhost:5432/lazyscan",
		"REDIS_URL":                 "redis://localhost:6379",
		"STORAGE_ENDPOINT":          "http://localhost:9000",
		"STORAGE_ACCESS_KEY_ID":     "lazyscan",
		"STORAGE_SECRET_ACCESS_KEY": "lazyscansecret",
		"STORAGE_BUCKET":            "lazyscan",
		"STORAGE_PUBLIC_DOMAIN":     "http://localhost:9000/lazyscan",
	}
}

func TestLoad_Defaults(t *testing.T) {
	cfg, err := Load(stubEnv(requiredEnv()))
	if err != nil {
		t.Fatalf("Load() error = %v", err)
	}

	if cfg.Port != "8001" {
		t.Errorf("Port = %q, want 8001", cfg.Port)
	}
	if cfg.ClaimIdle != 60*time.Second {
		t.Errorf("ClaimIdle = %v, want 60s", cfg.ClaimIdle)
	}
	if cfg.MaxDeliveries != 5 {
		t.Errorf("MaxDeliveries = %d, want 5", cfg.MaxDeliveries)
	}
	if cfg.Concurrency != 2 {
		t.Errorf("Concurrency = %d, want 2 (BullMQ parity)", cfg.Concurrency)
	}
	if cfg.StorageRegion != "us-east-1" {
		t.Errorf("StorageRegion = %q, want us-east-1", cfg.StorageRegion)
	}
	if !cfg.StorageForcePathStyle {
		t.Error("StorageForcePathStyle = false, want true by default")
	}
}

func TestLoad_CustomValues(t *testing.T) {
	env := requiredEnv()
	env["IMAGE_SVC_PORT"] = "9999"
	env["IMAGE_SVC_CONSUMER_CLAIM_IDLE"] = "5s"
	env["IMAGE_SVC_CONSUMER_MAX_DELIVERIES"] = "3"
	env["IMAGE_SVC_CONSUMER_CONCURRENCY"] = "4"

	cfg, err := Load(stubEnv(env))
	if err != nil {
		t.Fatalf("Load() error = %v", err)
	}

	if cfg.Port != "9999" {
		t.Errorf("Port = %q, want 9999", cfg.Port)
	}
	if cfg.DatabaseURL != env["DATABASE_URL"] {
		t.Errorf("DatabaseURL = %q, want %q", cfg.DatabaseURL, env["DATABASE_URL"])
	}
	if cfg.RedisURL != env["REDIS_URL"] {
		t.Errorf("RedisURL = %q, want %q", cfg.RedisURL, env["REDIS_URL"])
	}
	if cfg.ClaimIdle != 5*time.Second {
		t.Errorf("ClaimIdle = %v, want 5s", cfg.ClaimIdle)
	}
	if cfg.MaxDeliveries != 3 {
		t.Errorf("MaxDeliveries = %d, want 3", cfg.MaxDeliveries)
	}
	if cfg.Concurrency != 4 {
		t.Errorf("Concurrency = %d, want 4", cfg.Concurrency)
	}
}

func TestLoad_InvalidPort(t *testing.T) {
	env := requiredEnv()
	env["IMAGE_SVC_PORT"] = "not-a-port"
	if _, err := Load(stubEnv(env)); err == nil {
		t.Error("Load() = nil error, want error for non-numeric IMAGE_SVC_PORT")
	}
}

func TestLoad_RequiredVars(t *testing.T) {
	for _, missing := range []string{
		"DATABASE_URL", "REDIS_URL",
		"STORAGE_ENDPOINT", "STORAGE_ACCESS_KEY_ID", "STORAGE_SECRET_ACCESS_KEY",
		"STORAGE_BUCKET", "STORAGE_PUBLIC_DOMAIN",
	} {
		env := requiredEnv()
		delete(env, missing)
		if _, err := Load(stubEnv(env)); err == nil {
			t.Errorf("Load() = nil error, want error for missing %s", missing)
		}
	}
}

func TestLoad_StorageCustomValues(t *testing.T) {
	env := requiredEnv()
	env["STORAGE_REGION"] = "auto"
	env["STORAGE_FORCE_PATH_STYLE"] = "false"

	cfg, err := Load(stubEnv(env))
	if err != nil {
		t.Fatalf("Load() error = %v", err)
	}
	if cfg.StorageRegion != "auto" {
		t.Errorf("StorageRegion = %q, want auto", cfg.StorageRegion)
	}
	if cfg.StorageForcePathStyle {
		t.Error("StorageForcePathStyle = true, want false")
	}
}

func TestLoad_InvalidPathStyle(t *testing.T) {
	env := requiredEnv()
	env["STORAGE_FORCE_PATH_STYLE"] = "yes please"
	if _, err := Load(stubEnv(env)); err == nil {
		t.Error("Load() = nil error, want error for non-boolean STORAGE_FORCE_PATH_STYLE")
	}
}

func TestLoad_InvalidTunables(t *testing.T) {
	cases := map[string]map[string]string{
		"claim idle not a duration": {"IMAGE_SVC_CONSUMER_CLAIM_IDLE": "sixty"},
		"claim idle zero":           {"IMAGE_SVC_CONSUMER_CLAIM_IDLE": "0s"},
		"claim idle negative":       {"IMAGE_SVC_CONSUMER_CLAIM_IDLE": "-5s"},
		"max deliveries not an int": {"IMAGE_SVC_CONSUMER_MAX_DELIVERIES": "five"},
		"max deliveries zero":       {"IMAGE_SVC_CONSUMER_MAX_DELIVERIES": "0"},
		"concurrency not an int":    {"IMAGE_SVC_CONSUMER_CONCURRENCY": "two"},
		"concurrency zero":          {"IMAGE_SVC_CONSUMER_CONCURRENCY": "0"},
		"concurrency negative":      {"IMAGE_SVC_CONSUMER_CONCURRENCY": "-1"},
	}
	for name, overrides := range cases {
		env := requiredEnv()
		for k, v := range overrides {
			env[k] = v
		}
		if _, err := Load(stubEnv(env)); err == nil {
			t.Errorf("Load() = nil error, want error for %s", name)
		}
	}
}
