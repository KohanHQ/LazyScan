# Secrets
JWT_SECRET=change-me
POSTGRES_PASSWORD=change-me

# R2 storage (used by api, image-svc)
# api storage profile: `s3` reads STORAGE_* (R2-via-S3); default `r2` reads
# CLOUDFLARE_* (unset here). Keep s3. image-svc reads STORAGE_* directly.
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=change-me
STORAGE_SECRET_ACCESS_KEY=change-me
STORAGE_BUCKET=lazyscan
STORAGE_PUBLIC_DOMAIN=https://cdn.sanctuary.my.id     # R2 custom domain or *.r2.dev
STORAGE_QUOTA_BYTES=8589934592                         # 8 GiB (under R2 free 10 GB)
ENABLE_STORAGE_PRUNE=true

# image-svc HTTP (avatars/covers)
IMAGE_SVC_URL=http://image-svc:8001

# SMTP (mail-svc) — Sumopod SMTPS profile (implicit TLS on 465).
# For a STARTTLS host instead: SMTP_PORT=587, SMTP_SSL=false, SMTP_STARTTLS=true.
SMTP_HOST=smtp.sumopod.com
SMTP_PORT=465
SMTP_USER=noreply@your.domain
SMTP_PASS=change-me
SMTP_FROM=noreply@your.domain
SMTP_SSL=true
SMTP_STARTTLS=false

# Bootstrap
DEFAULT_SUPERUSER_EMAIL=admin@example.com
DEFAULT_SUPERUSER_PASSWORD=change-me

# Rate limiting on the public deploy: per-IP limiter + stricter auth/public
# buckets. TRUST_PROXY keys on nginx's X-Real-IP (from CF-Connecting-IP).
ENABLE_RATE_LIMIT=true
TRUST_PROXY=true
