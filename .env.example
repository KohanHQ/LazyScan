# Secrets
JWT_SECRET=change-me

# DSN
DATABASE_URL=postgres://lazyscan:change-me@shared-postgres:5432/lazyscan
REDIS_URL=redis://shared-redis:6379

# Storage
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=change-me
STORAGE_SECRET_ACCESS_KEY=change-me
STORAGE_BUCKET=lazyscan
STORAGE_PUBLIC_DOMAIN=https://cdn.domain.com
# 8 GiB (under R2 free 10 GB)
STORAGE_QUOTA_BYTES=8589934592                         
ENABLE_STORAGE_PRUNE=true

# image-svc (HTTP)
IMAGE_SVC_URL=http://image-svc:8001

# mail-svc (SMTP)
SMTP_HOST=smtp.domain.com
SMTP_PORT=465
SMTP_USER=noreply@your.domain
SMTP_PASS=change-me
SMTP_FROM=noreply@your.domain
SMTP_SSL=true
SMTP_STARTTLS=false

# Bootstrap
DEFAULT_SUPERUSER_EMAIL=admin@example.com
DEFAULT_SUPERUSER_PASSWORD=change-me

# Rate limiting on the public deploy: per-IP limiter + stricter auth/public buckets. 
# TRUST_PROXY keys on nginx's X-Real-IP (from CF-Connecting-IP).
ENABLE_RATE_LIMIT=true
TRUST_PROXY=true
