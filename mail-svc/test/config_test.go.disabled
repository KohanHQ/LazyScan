package config

import (
	"strings"
	"testing"
	"time"
)

func stubEnv(values map[string]string) func(string) string {
	return func(key string) string { return values[key] }
}

func validEnv() map[string]string {
	return map[string]string{
		"DATABASE_URL": "postgres://localhost/lazyscan",
		"REDIS_URL":    "redis://localhost:6379",
		"SMTP_HOST":    "mailpit",
		"SMTP_PORT":    "1025",
		"SMTP_FROM":    "no-reply@lazyscan.local",
	}
}

func TestLoadDefaults(t *testing.T) {
	cfg, err := Load(stubEnv(validEnv()))
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if cfg.Addr != ":8086" {
		t.Errorf("Addr = %q, want :8086", cfg.Addr)
	}
	if cfg.LogFormat != "text" {
		t.Errorf("LogFormat = %q, want text", cfg.LogFormat)
	}
	if !cfg.SMTPStartTLS {
		t.Error("SMTPStartTLS = false, want true (secure default)")
	}
	if cfg.SMTPUsername != "" || cfg.SMTPPassword != "" {
		t.Errorf("SMTPUsername/SMTPPassword = %q/%q, want empty", cfg.SMTPUsername, cfg.SMTPPassword)
	}
	if cfg.ClaimIdle != 60*time.Second {
		t.Errorf("ClaimIdle = %v, want 60s", cfg.ClaimIdle)
	}
	if cfg.MaxDeliveries != 5 {
		t.Errorf("MaxDeliveries = %d, want 5", cfg.MaxDeliveries)
	}
	if cfg.Concurrency != 1 {
		t.Errorf("Concurrency = %d, want 1", cfg.Concurrency)
	}
}

func TestLoadOverrides(t *testing.T) {
	env := validEnv()
	env["HERALD_ADDR"] = ":9000"
	env["HERALD_LOG_FORMAT"] = "json"
	env["SMTP_USERNAME"] = "mailer"
	env["SMTP_PASSWORD"] = "hunter2"
	env["SMTP_STARTTLS"] = "false"
	env["HERALD_CONSUMER_CLAIM_IDLE"] = "2m"
	env["HERALD_CONSUMER_MAX_DELIVERIES"] = "3"
	env["HERALD_CONSUMER_CONCURRENCY"] = "4"

	cfg, err := Load(stubEnv(env))
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if cfg.Addr != ":9000" || cfg.LogFormat != "json" {
		t.Errorf("Addr/LogFormat = %q/%q", cfg.Addr, cfg.LogFormat)
	}
	if cfg.SMTPHost != "mailpit" || cfg.SMTPPort != 1025 || cfg.SMTPFrom != "no-reply@lazyscan.local" {
		t.Errorf("SMTPHost/SMTPPort/SMTPFrom = %q/%d/%q", cfg.SMTPHost, cfg.SMTPPort, cfg.SMTPFrom)
	}
	if cfg.SMTPUsername != "mailer" || cfg.SMTPPassword != "hunter2" {
		t.Errorf("SMTPUsername/SMTPPassword = %q/%q", cfg.SMTPUsername, cfg.SMTPPassword)
	}
	if cfg.SMTPStartTLS {
		t.Error("SMTPStartTLS = true, want false")
	}
	if cfg.ClaimIdle != 2*time.Minute {
		t.Errorf("ClaimIdle = %v, want 2m", cfg.ClaimIdle)
	}
	if cfg.MaxDeliveries != 3 || cfg.Concurrency != 4 {
		t.Errorf("MaxDeliveries/Concurrency = %d/%d", cfg.MaxDeliveries, cfg.Concurrency)
	}
}

func TestLoadRejectsInvalid(t *testing.T) {
	tests := []struct {
		name    string
		mutate  func(map[string]string)
		wantErr string
	}{
		{"missing database url", func(m map[string]string) { delete(m, "DATABASE_URL") }, "DATABASE_URL"},
		{"missing redis url", func(m map[string]string) { delete(m, "REDIS_URL") }, "REDIS_URL"},
		{"bad log format", func(m map[string]string) { m["HERALD_LOG_FORMAT"] = "xml" }, "HERALD_LOG_FORMAT"},
		{"missing smtp host", func(m map[string]string) { delete(m, "SMTP_HOST") }, "SMTP_HOST"},
		{"missing smtp port", func(m map[string]string) { delete(m, "SMTP_PORT") }, "SMTP_PORT"},
		{"bad smtp port", func(m map[string]string) { m["SMTP_PORT"] = "smtp" }, "SMTP_PORT"},
		{"out of range smtp port", func(m map[string]string) { m["SMTP_PORT"] = "65536" }, "SMTP_PORT"},
		{"missing smtp from", func(m map[string]string) { delete(m, "SMTP_FROM") }, "SMTP_FROM"},
		{"username without password", func(m map[string]string) { m["SMTP_USERNAME"] = "mailer" }, "SMTP_USERNAME"},
		{"password without username", func(m map[string]string) { m["SMTP_PASSWORD"] = "hunter2" }, "SMTP_USERNAME"},
		{"bad starttls", func(m map[string]string) { m["SMTP_STARTTLS"] = "maybe" }, "SMTP_STARTTLS"},
		{"bad claim idle", func(m map[string]string) { m["HERALD_CONSUMER_CLAIM_IDLE"] = "soon" }, "HERALD_CONSUMER_CLAIM_IDLE"},
		{"negative claim idle", func(m map[string]string) { m["HERALD_CONSUMER_CLAIM_IDLE"] = "-1s" }, "HERALD_CONSUMER_CLAIM_IDLE"},
		{"bad max deliveries", func(m map[string]string) { m["HERALD_CONSUMER_MAX_DELIVERIES"] = "0" }, "HERALD_CONSUMER_MAX_DELIVERIES"},
		{"bad concurrency", func(m map[string]string) { m["HERALD_CONSUMER_CONCURRENCY"] = "zero" }, "HERALD_CONSUMER_CONCURRENCY"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			env := validEnv()
			tt.mutate(env)
			_, err := Load(stubEnv(env))
			if err == nil {
				t.Fatal("Load: want error, got nil")
			}
			if !strings.Contains(err.Error(), tt.wantErr) {
				t.Errorf("error %q does not mention %q", err, tt.wantErr)
			}
		})
	}
}
