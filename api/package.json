{
  "name": "api",
  "version": "1.0.50",
  "scripts": {
    "test": "TEST_DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://lazyscan:lazyscan@localhost:5432/lazyscan_test}\" bun test src/test",
    "test:db": "bash scripts/test-db.sh",
    "test:local": "bun run test:db && bun run test",
    "typecheck": "bunx tsc --noEmit",
    "dev": "bun run --watch src/index.ts",
    "backfill:r2": "bun run src/scripts/backfill-r2-public-domain.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "3.958.0",
    "@rasla/logify": "^5.1.2",
    "bcrypt": "^6.0.0",
    "elysia": "1.4.27",
    "ioredis": "^5.10.1",
    "jose": "^6.1.3",
    "nanoid": "^5.1.6",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "bun-types": "latest"
  },
  "overrides": {
    "elysia": "1.4.27"
  },
  "module": "src/index.js"
}
